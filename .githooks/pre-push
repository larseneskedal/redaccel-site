#!/bin/sh
# Refuses a push when the site checks fail on the commit being pushed.
# Turned on per clone with:  git config core.hooksPath .githooks
# (done on the mini 2026-10-28; GitHub Actions + Render "deploy when checks pass" cover
# pushes from anywhere else, and pushes made with --no-verify).
REPO="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # deleting a branch
  tmp="$(mktemp -d /tmp/redaccel-prepush.XXXXXX)"
  git -C "$REPO" archive "$local_sha" | tar -x -C "$tmp"
  echo "pre-push: checking $(git -C "$REPO" log -1 --format='%h %s' "$local_sha") -> $remote_ref"
  if ! "$REPO/tools/ci/check.sh" "$tmp"; then
    echo ""
    echo "pre-push: REFUSED. The site checks failed on $local_sha, so this push would break redaccel.com."
    echo "pre-push: fix the failures above (run tools/ci/check.sh), commit, and push again."
    status=1
  fi
  rm -rf "$tmp"
done
exit $status
